# 环境与密钥
.env
.env.*
!.env.example

# 运行产物
runs/*
!runs/.gitkeep
logs/*
!logs/.gitkeep
*.log

# 解密数据 / 微信相关（绝对禁止上传）
*.db
*.db-wal
*.db-shm
.wechat_media/

# 缓存与临时文件
cache/
tmp/
__pycache__/
*.py[cod]
.pytest_cache/

# Python
.venv/
venv/
build/
dist/
*.spec
*.egg-info/

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 其他工具 / 与本项目无关的本地目录（不提交，也不导出给他人）
.opencode/
证据/

# 旧启动脚本备份（本机回退用，不发布）
_旧脚本备份/

# 对外分享版报告（含真实聊天摘要，绝不入库/发布）
share/

# 公开发布时必须排除（含真实群名/昵称、私有材料、未施工的效果图）
# 注：这些文件在本机继续使用，只是不进公开仓库。
config/groups.yaml
config/pins.yaml
给老师/
preview_*.png

# 文档目录要随仓库发布（部署手册 / 架构说明 / 交接记录都在里面）；
# 只有大体积预览图不入库，避免仓库被 PNG 撑大。
docs/*.png

# 打包产物 / 一次性演示材料（可随时用脚本重新生成，不必入库）
demo-site/dist/
演示版/
演示站-发给Mac.zip
_tmp_*.png
