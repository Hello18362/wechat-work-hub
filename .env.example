# ===== 在线大模型总结（DeepSeek，推荐）=====
# 把下面两行改成你自己的值，保存为 .env（不要提交到 git）
# 然后把 settings.yaml 里的 summarizer.provider 设为 deepseek 即可。
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-chat

# ===== 兼容别名：下面任一写法也能被识别 =====
# OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://api.deepseek.com

# ===== 火山方舟 / 豆包（可选，改用豆包时填）=====
# DOUBAO_API_KEY=your_api_key_here
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_TEXT_MODEL=doubao-seed-1904

# ===== SIWX 解密数据目录（本机绝对路径，隐私，务必放 .env 而非 settings.yaml）=====
# WX_DECRYPTED_DIR=C:/你的路径/siwx/output/wxid_xxx
